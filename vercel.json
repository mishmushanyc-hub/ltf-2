{
  "images": {
    "sizes": [
      256,
      640,
      1080,
      1920
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "localPatterns": [
      {
        "pathname": "^/images/.*$",
        "search": ""
      }
    ]
  },
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "cleanUrls": true
}